# clean base image containing only comfyui, comfy-cli and comfyui-manager
FROM runpod/worker-comfyui:5.10.0-base

# build-time tokens for gated downloads are read from BuildKit secret
# mounts — they are never written to a layer or to image history.
# pass via: docker buildx build --secret id=hf_token,env=HF_TOKEN .

# install custom nodes into comfyui
RUN git clone https://github.com/lbouaraba/comfyui-krea2edit /comfyui/custom_nodes/comfyui-krea2edit && cd /comfyui/custom_nodes/comfyui-krea2edit && (git checkout 86f886dac23013d88996e3a2e99093ba44d322fb 2>/dev/null || (git fetch origin 86f886dac23013d88996e3a2e99093ba44d322fb --depth=1 && git checkout 86f886dac23013d88996e3a2e99093ba44d322fb) || echo "WARN: commit 86f886dac23013d88996e3a2e99093ba44d322fb unreachable in https://github.com/lbouaraba/comfyui-krea2edit, falling back to default branch HEAD")
RUN git clone https://github.com/rgthree/rgthree-comfy /comfyui/custom_nodes/rgthree-comfy && cd /comfyui/custom_nodes/rgthree-comfy && (git checkout 8ff50e4521881eca1fe26aec9615fc9362474931 2>/dev/null || (git fetch origin 8ff50e4521881eca1fe26aec9615fc9362474931 --depth=1 && git checkout 8ff50e4521881eca1fe26aec9615fc9362474931) || echo "WARN: commit 8ff50e4521881eca1fe26aec9615fc9362474931 unreachable in https://github.com/rgthree/rgthree-comfy, falling back to default branch HEAD")
RUN comfy node install --exit-on-fail comfyui-custom-scripts@1.2.5 --mode remote || (echo "WARN: comfyui-custom-scripts@1.2.5 unavailable in registry, falling back to latest" >&2 && comfy node install --exit-on-fail comfyui-custom-scripts --mode remote)
RUN git clone https://github.com/giriss/comfy-image-saver /comfyui/custom_nodes/comfy-image-saver && cd /comfyui/custom_nodes/comfy-image-saver && (git checkout c6223965d45871d1ff2931b6ac9518a13947c920 2>/dev/null || (git fetch origin c6223965d45871d1ff2931b6ac9518a13947c920 --depth=1 && git checkout c6223965d45871d1ff2931b6ac9518a13947c920) || echo "WARN: commit c6223965d45871d1ff2931b6ac9518a13947c920 unreachable in https://github.com/giriss/comfy-image-saver, falling back to default branch HEAD")

# download models into comfyui
RUN --mount=type=secret,id=hf_token BACKOFFS="10 20 30 60 90" && for i in 1 2 3 4 5; do HF_TOKEN="$(cat /run/secrets/hf_token 2>/dev/null || true)" comfy model download --url 'https://huggingface.co/Comfy-Org/Krea-2/resolve/main/diffusion_models/krea2_turbo_fp8_scaled.safetensors' --relative-path models/Unknown --filename 'Krea2/krea2_turbo_fp8_scaled.safetensors' && break; if [ $i -eq 5 ]; then echo "model-download failed after 5 attempts" >&2; exit 1; fi; SLEEP=$(echo $BACKOFFS | cut -d ' ' -f $i) && echo "model-download attempt $i failed; retrying in $SLEEP seconds" >&2; sleep $SLEEP; done
